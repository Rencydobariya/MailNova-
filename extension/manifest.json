{
  "manifest_version": 3,
  "name": "MailNova",
  "description": "AI Powered Smart Email Assistant",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
  {
    "matches": [
      "https://mail.google.com/*"
    ],
    "js": [
    "content.js",
    "utils/drag.js",
    "utils/resize.js",
    "utils/api.js",
    "ui/workspace.js",
    "ui/floating-button.js"
    ],
    
    "css": [
      "styles/button.css",
      "styles/workspace.css"
    ]
  }
]
}