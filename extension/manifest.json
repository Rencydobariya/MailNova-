{
  "manifest_version": 3,
  "name": "MailNova",
  "description": "AI email assistant for Gmail: summarize and prioritize messages, flag spam, and send replies only when you choose.",
  "version": "1.0.2",

  "icons": {
    "16": "assets/icons/mailnova-mascot-16.png",
    "48": "assets/icons/mailnova-mascot-48.png",
    "128": "assets/icons/mailnova-mascot-128.png"
  },

  "permissions": [
    "storage",
    "identity"
  ],

  "oauth2": {
    "client_id": "582131744564-7lk1vpsuijik7k498m6dp6muc41a8dkq.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.send"
    ]
  },

  "host_permissions": [
    "https://mail.google.com/*",
    "https://mailnova-9tzz.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
  {
    "matches": [
      "https://mail.google.com/*"
    ],


        "js": [
      "content.js",

      "utils/drag.js",
      "utils/resize.js",
      "utils/api.js",
      "utils/ai-intelligence.js",
      "utils/priority.js",
      "utils/category-engine.js",
      "utils/filter.js",
      

      "gmail/gmail-parser.js",

      "ui/header.js",
      "ui/search.js",
      "ui/category-bar.js",
      "ui/email-card.js",
      "ui/email-list.js",
      "ui/settings.js",
      "ui/notifications.js",
       
      "ui/ask-ai.js",
      "ui/reply.js",
      "ui/workspace.js",
      "ui/floating-button.js"
    ],
    
        "css": [
        "styles/button.css",
        "styles/workspace.css",
        "styles/header.css",
        "styles/search.css",
        "styles/categories.css",
        "styles/cards.css",
        "styles/settings.css",
        "styles/notifications.css",
        "styles/animations.css",
        "styles/ask-ai.css",
        "styles/reply.css"
      ]
  }
],

"web_accessible_resources": [
  {
    "resources": [
      "assets/icons/logo_1.png",
      "assets/icons/logo_17.png",
      "assets/icons/mailnova-mascot.png"
      
    ],
    "matches": [
      "https://mail.google.com/*"
    ]
  }
]

}
